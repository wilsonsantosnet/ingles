{
  "name": "english-spaced-repetition",
  "version": "1.0.0",
  "description": "Sistema de repetição espaçada para estudo de inglês com enriquecimento por LLM",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "process": "node src/processDocuments.js",
    "process:force": "node src/processDocuments.js --force",
    "study": "node src/server.js",
    "categories": "node src/manageCategories.js",
    "categories:list": "node src/manageCategories.js list",
    "categories:create": "node src/manageCategories.js create",
    "clean:titles": "node src/cleanTitles.js",
    "azure:json:pull": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/pull-azure-json.ps1"
  },
  "keywords": [
    "english",
    "spaced-repetition",
    "learning",
    "llm"
  ],
  "author": "Wilson dos Santos",
  "license": "MIT",
  "dependencies": {
    "@azure/cognitiveservices-computervision": "^8.2.0",
    "@azure/identity": "^4.13.0",
    "@azure/ms-rest-azure-js": "^2.1.0",
    "docxtemplater": "^3.67.6",
    "express": "^4.18.2",
    "mammoth": "^1.7.2",
    "multer": "^2.1.1",
    "openai": "^6.17.0",
    "pizzip": "^3.2.0",
    "sharp": "^0.34.5"
  }
}
