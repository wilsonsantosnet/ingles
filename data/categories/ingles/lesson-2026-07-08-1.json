      {
        "topic": "Countable vs. Uncountable nouns",
        "explanation": "Some nouns are countable (country, answer, technology/technologies) and others can be uncountable depending on meaning (space as uncountable for room/area). This affects use of articles and quantifiers.",
        "rules": [
          "Use 'a'/'an' with singular countable nouns: 'a country', 'an answer'.",
          "Use plural for multiple countable items: 'two countries', 'many technologies'.",
          "Do not use 'a' with uncountable nouns like 'space' when meaning area: 'There is space' (not 'a space' unless referring to a single slot or location)."
        ],
        "examples": [
          "She visited three countries last year.",
          "There is not enough space in the database."
        ],
        "commonMistakes": [
          "Saying 'a space' when meaning general room: prefer 'space' without article unless specific.",
          "Using plural when the noun is uncountable: 'informations' (incorrect) instead of 'information'."
        ],
