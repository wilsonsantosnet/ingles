    "grammar": [
      {
        "topic": "Substantive vs. Verbal use (noun vs. verb)",
        "explanation": "Some words in English can be both nouns and verbs (e.g., function, answer). The sentence structure and verb forms change depending on the use.",
        "rules": [
          "When used as a noun, position it after determiners/articles (a/the) or adjectives: 'the function is clear.'",
          "When used as a verb, conjugate according to subject and tense: 'She answers the question.'",
          "Use correct verb patterns after verbs: 'evaluate' is followed by a noun or clause: 'evaluate the result' or 'evaluate whether...' "
        ],
        "examples": [
          "The function of this button is to start the device. (noun)",
          "Can you function properly after the update? (verb)",
          "Please answer the email. (verb)",
          "I still don't have the answer. (noun)"
        ],
        "commonMistakes": [
          "Using the verb form without conjugation: 'She answer the question' (should be 'answers').",
          "Confusing noun and verb placement: 'Function clear is' instead of 'The function is clear.'"
        ],
        "id": "grammar-lesson-2026-07-08-1-0",
