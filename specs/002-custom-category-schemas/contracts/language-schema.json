{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Language Category Enriched Content Schema",
  "description": "Schema for validating enriched content structure for language-type categories",
  "type": "object",
  "required": ["enriched"],
  "properties": {
    "enriched": {
      "type": "object",
      "required": [
        "vocabulary",
        "grammar",
        "expressions",
        "exercises",
        "culturalNotes"
      ],
      "properties": {
        "vocabulary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["word", "translation", "definition", "examples"],
            "properties": {
              "word": {
                "type": "string",
                "minLength": 1
              },
              "translation": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "pronunciation": {
                "type": "string"
              },
              "partOfSpeech": {
                "type": "string",
                "enum": ["noun", "verb", "adjective", "adverb", "preposition", "conjunction", "pronoun", "interjection"]
              },
              "synonyms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "difficulty": {
                "type": "string",
                "enum": ["beginner", "intermediate", "advanced"]
              }
            }
          }
        },
        "grammar": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["topic", "explanation", "rules", "examples"],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "examples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "commonMistakes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "expressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["expression", "meaning", "usage", "examples"],
            "properties": {
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "usage": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "exercises": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["type", "question", "answer"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["fill-blank", "translation", "multiple-choice", "reorder", "matching"]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "hint": {
                "type": "string"
              }
            }
          }
        },
        "culturalNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["topic", "content"],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
