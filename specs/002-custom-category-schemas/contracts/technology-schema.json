{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Technology Category Enriched Content Schema",
  "description": "Schema for validating enriched content structure for technology-type categories",
  "type": "object",
  "required": ["enriched"],
  "properties": {
    "enriched": {
      "type": "object",
      "required": [
        "topics",
        "concepts",
        "commands",
        "scenarios",
        "exercises",
        "examTips"
      ],
      "properties": {
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string"
              },
              "importance": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            }
          }
        },
        "concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["concept", "definition", "examples"],
            "properties": {
              "concept": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "relatedConcepts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "difficulty": {
                "type": "string",
                "enum": ["beginner", "intermediate", "advanced"]
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "description", "syntax", "examples"],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "syntax": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "platform": {
                "type": "string",
                "enum": ["Azure CLI", "PowerShell", "Portal", "ARM Template", "Bicep", "Terraform", "REST API"]
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scenario", "problem", "solution", "explanation"],
            "properties": {
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "problem": {
                "type": "string",
                "minLength": 1
              },
              "solution": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "exercises": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["type", "question", "answer"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["scenario-based", "command-completion", "concept-definition", "troubleshooting", "multiple-choice"]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "hint": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              }
            }
          }
        },
        "examTips": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tip", "relevance"],
            "properties": {
              "tip": {
                "type": "string",
                "minLength": 1
              },
              "relevance": {
                "type": "string",
                "minLength": 1
              },
              "topic": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
